<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/bg">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp" android:layout_marginBottom="10dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/text"/>
        <TextView style="@style/Label" android:text="AIS server address (given by AIS)"/>
        <EditText android:id="@+id/edServer" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="https://tracker.example.com" android:inputType="textUri"/>
        <TextView style="@style/Label" android:text="API key (given by AIS)"/>
        <EditText android:id="@+id/edKey" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="AIS-XXXXXXXX..." android:inputType="textVisiblePassword|textNoSuggestions"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="12dp">
            <Button android:id="@+id/btnTest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Test connection" android:backgroundTint="@color/blue"/>
            <Button android:id="@+id/btnSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Save" android:layout_marginStart="8dp" android:backgroundTint="@color/green"/>
        </LinearLayout>
        <TextView android:id="@+id/txtTest" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:layout_marginTop="8dp"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/bg_card" android:padding="14dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Keep tracking in background" android:textStyle="bold" android:textSize="15sp" android:textColor="@color/text"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="13sp" android:textColor="@color/muted" android:layout_marginTop="4dp"
            android:text="Some phones stop background apps to save battery. Allow this app to run without battery restrictions so location keeps going out during the whole trip."/>
        <Button android:id="@+id/btnBattery" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Allow background running" android:layout_marginTop="8dp" android:backgroundTint="@color/amber"/>
    </LinearLayout>
</LinearLayout>
</ScrollView>
